# Copy to .backend.env and fill with real secrets. NEVER commit the real file.
PORT=3000

# JWT signing secret. MUST be >= 32 chars of high entropy. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET=change-me-to-a-long-random-value-at-least-32-chars

SALT_ROUNDS=10

# Set to "production" in deployment: disables debug endpoints.
NODE_ENV=production

# Mongo credentials — use a strong, unique password.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-strong-password
MONGO_URI=mongodb://${MONGO_ROOT_USERNAME}:${MONGO_ROOT_PASSWORD}@database:27017/test?authSource=admin
