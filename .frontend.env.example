# Copy to .frontend.env. NEVER commit the real file.
ORIGIN=https://homecalendar.casa

# WARNING: NODE_TLS_REJECT_UNAUTHORIZED=0 disables ALL TLS certificate
# verification in the SvelteKit Node process. It is currently required because
# the frontend reaches the backend over a self-signed cert at https://backend:3000.
# Prefer issuing a cert with SAN=backend and trusting it via NODE_EXTRA_CA_CERTS
# instead of disabling verification globally. See SECURITY-REPORT.md.
NODE_TLS_REJECT_UNAUTHORIZED=0
